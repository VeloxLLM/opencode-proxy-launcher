<Window x:Class="OpenCodeProxyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenCode Proxy Launcher"
        Width="900" Height="600"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="OC" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AppTitleText" Margin="10,0,0,0" FontSize="13.5"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="LangButton" Style="{StaticResource TitleBarTextButton}" Click="LangButton_Click" />
                <Button x:Name="ThemeButton" Style="{StaticResource TitleBarButton}" Click="ThemeButton_Click" />
                <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                        Click="MinButton_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================= 内容 ================= -->
        <Grid x:Name="ContentRoot" Grid.Row="1" Margin="20,6,20,20" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 标签页 ===== -->
            <TabControl x:Name="MainTabs" Grid.Row="0" Style="{StaticResource FlatTabControl}">

                <!-- 设置 -->
                <TabItem x:Name="TabSettings" Style="{StaticResource FlatTabItem}">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock x:Name="SettingsSubtitle" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProxyLabel" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource InputBorder}">
                                <TextBox x:Name="ProxyBox" Style="{StaticResource FieldTextBox}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PathLabel" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource InputBorder}">
                                <TextBox x:Name="PathBox" Style="{StaticResource FieldTextBox}" />
                            </Border>
                            <Button x:Name="BrowseButton" Grid.Column="2" Width="76" Margin="8,0,0,0"
                                    Style="{StaticResource SmallButton}" Click="BrowseButton_Click" />
                            <Button x:Name="DetectButton" Grid.Column="3" Width="88" Margin="8,0,0,0"
                                    Style="{StaticResource SmallButton}" Click="DetectButton_Click" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NoProxyLabel" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Style="{StaticResource InputBorder}">
                                <TextBox x:Name="NoProxyBox" Style="{StaticResource FieldTextBox}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="WebUiCheck" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ModernCheckBox}"
                                      Checked="WebUiCheck_Changed" Unchecked="WebUiCheck_Changed" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="WebUiPortLabel" VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Border Style="{StaticResource InputBorder}" Width="86" Height="32">
                                    <TextBox x:Name="WebUiPortBox" Style="{StaticResource FieldTextBox}"
                                             FontSize="12.5" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="WebUiOpenButton" Grid.Column="3" Width="66" Height="32"
                                    Margin="10,0,0,0" Style="{StaticResource SmallButton}"
                                    Click="WebUiOpenButton_Click" />
                        </Grid>
                        <TextBlock x:Name="WebUiHint" Margin="92,7,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <CheckBox x:Name="CloseAfterCheck" Margin="92,16,0,0"
                                  Style="{StaticResource ModernCheckBox}" />
                    </StackPanel>
                </TabItem>

                <!-- 用量 -->
                <TabItem x:Name="TabUsage" Style="{StaticResource FlatTabItem}">
                    <StackPanel Margin="20,16,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="UsageUnitLabel" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UnitRaw" Width="48" Margin="0,0,4,0" Tag="raw" Click="Unit_Click" />
                                <Button x:Name="UnitWan" Width="46" Margin="0,0,4,0" Tag="wan" Click="Unit_Click" />
                                <Button x:Name="UnitQianWan" Width="60" Margin="0,0,4,0" Tag="qianwan" Click="Unit_Click" />
                                <Button x:Name="UnitYi" Width="46" Tag="yi" Click="Unit_Click" />
                                <Button x:Name="UsageRefreshButton" Width="34" Height="26" Margin="10,0,0,0"
                                        Style="{StaticResource SmallButton}" Content="&#xE72C;"
                                        FontFamily="{StaticResource IconFont}" FontSize="11"
                                        Click="UsageRefreshButton_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="AccountLabel" Margin="0,18,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel x:Name="AccountChips" Margin="0,9,0,0" />

                        <TextBlock x:Name="LocalLabel" Margin="0,16,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel x:Name="LocalChips" Margin="0,9,0,0" />
                    </StackPanel>
                </TabItem>

                <!-- 日志 -->
                <TabItem x:Name="TabLog" Style="{StaticResource FlatTabItem}">
                    <Grid Margin="18,16,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LogHint" Grid.Row="0" Margin="2,0,0,10" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Grid.Row="1" CornerRadius="8"
                                Background="{DynamicResource LogBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="12,9">
                            <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Foreground="{DynamicResource LogTextBrush}" IsReadOnly="True"
                                     TextWrapping="NoWrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnlyCaretVisible="False" />
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ===== 底部：按钮 + 状态 ===== -->
            <Grid x:Name="ButtonRow" Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="LaunchButton" Width="156"
                            Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click" />
                    <Button x:Name="CheckButton" Width="116" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="CheckButton_Click" />
                    <Button x:Name="SaveButton" Width="116" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="SaveButton_Click" />
                    <Button x:Name="ClearButton" Width="104" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="ClearButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
