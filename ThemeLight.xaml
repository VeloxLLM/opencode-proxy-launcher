<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题调色板 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E6EAF1" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#FAFBFD" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2633" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7C8899" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4C6FFF" />
    <Color x:Key="AccentColor">#4C6FFF</Color>
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5F7EFF" Offset="0" />
        <GradientStop Color="#3E5BEE" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#16B364" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F0A020" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5484D" />

    <SolidColorBrush x:Key="LogBgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#3A4557" />

    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#E7ECF5" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="CloseHoverTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CheckBoxBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FFFFFF" />

    <Color x:Key="ShadowColor">#1E2633</Color>

</ResourceDictionary>
